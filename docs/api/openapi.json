    "components": {
        "schemas": {
            "PolicyRequest": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "maxLength": 100,
                        "minLength": 0,
                        "pattern": "[a-z0-9][a-z0-9-]*"
                    },
                    "description": {
                        "type": "string",
                        "maxLength": 500,
                        "minLength": 0
                    },
                    "httpMethod": {
                        "type": "string",
                        "description": "null = any method",
                        "pattern": "GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS"
                    },
                    "endpointPattern": {
                        "type": "string",
                        "description": "Spring PathPattern",
                        "example": "/api/v1/**",
                        "maxLength": 255,
                        "minLength": 0,
                        "pattern": "/.*"
                    },
                    "tier": {
                        "type": "string",
                        "description": "null = any tier",
                        "enum": [
                            "ANONYMOUS",
                            "FREE",
                            "PREMIUM",
                            "ENTERPRISE"
                        ]
                    },
                    "keyBy": {
                        "type": "string",
                        "enum": [
                            "IP",
                            "USER"
                        ]
                    },
                    "algorithm": {
                        "type": "string",
                        "enum": [
                            "TOKEN_BUCKET",
                            "FIXED_WINDOW",
                            "SLIDING_WINDOW"
                        ]
                    },
                    "limit": {
                        "type": "integer",
                        "format": "int32",
                        "description": "Bucket capacity, or max requests per window",
                        "maximum": 1000000,
                        "minimum": 1
                    },
                    "windowMs": {
                        "type": "integer",
                        "format": "int64",
                        "description": "Window length, or token-bucket refill period, in ms",
                        "maximum": 86400000,
                        "minimum": 100
                    },
                    "refillTokens": {
                        "type": "integer",
                        "format": "int32",
                        "description": "TOKEN_BUCKET only: tokens added per windowMs (default = limit)",
                        "maximum": 1000000,
                        "minimum": 1
                    },
                    "failureMode": {
                        "type": "string",
                        "description": "null = global default",
                        "enum": [
                            "FAIL_OPEN",
                            "FAIL_CLOSED"
                        ]
                    },
                    "priority": {
                        "type": "integer",
                        "format": "int32",
                        "maximum": 1000,
                        "minimum": -1000
                    },
                    "enabled": {
                        "type": "boolean"
                    },
                    "version": {
                        "type": "integer",
                        "format": "int32",
                        "description": "Required on PUT: the version you read (optimistic locking)"
                    }
                },
                "required": [
                    "algorithm",
                    "endpointPattern",
                    "keyBy",
                    "limit",
                    "name",
                    "windowMs"
                ]
            },
            "PolicyResponse": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "httpMethod": {
                        "type": "string"
                    },
                    "endpointPattern": {
                        "type": "string"
                    },
                    "tier": {
                        "type": "string",
                        "enum": [
                            "ANONYMOUS",
                            "FREE",
                            "PREMIUM",
                            "ENTERPRISE"
                        ]
                    },
                    "keyBy": {
                        "type": "string",
                        "enum": [
                            "IP",
                            "USER"
                        ]
                    },
                    "algorithm": {
                        "type": "string",
                        "enum": [
                            "TOKEN_BUCKET",
                            "FIXED_WINDOW",
                            "SLIDING_WINDOW"
                        ]
                    },
                    "limit": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "windowMs": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "refillTokens": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "failureMode": {
                        "type": "string",
                        "enum": [
                            "FAIL_OPEN",
                            "FAIL_CLOSED"
                        ]
                    },
                    "priority": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "enabled": {
                        "type": "boolean"
                    },
                    "version": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "DemoTokenRequest": {
                "type": "object",
                "properties": {
                    "userId": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "[A-Za-z0-9._@-]{1,64}"
                    },
                    "tier": {
                        "type": "string",
                        "enum": [
                            "ANONYMOUS",
                            "FREE",
                            "PREMIUM",
                            "ENTERPRISE"
                        ]
                    },
                    "roles": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "pattern": "ADMIN"
                        }
                    },
                    "ttlSeconds": {
                        "type": "integer",
                        "format": "int32",
                        "maximum": 86400,
                        "minimum": 1
                    }
                },
                "required": [
                    "tier",
                    "userId"
                ]
            },
            "DemoTokenResponse": {
                "type": "object",
