# Copy to .env and replace every "change-me" value.  .env is git-ignored; never commit it.
# Used by Docker Compose and, in the dev profile, by the application (spring.config.import).

# ---------- MySQL (policy store) ----------
MYSQL_DATABASE=ratelimiter
MYSQL_USER=ratelimiter
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
# Host port for the Compose MySQL. 3307 avoids clashing with a locally installed MySQL on 3306.
MYSQL_HOST_PORT=3307

# ---------- Redis (rate-limit state) ----------
REDIS_HOST_PORT=6379
# Optional tuning (defaults shown)
# REDIS_COMMAND_TIMEOUT=50ms          # application default (local runs); the Compose stack uses the next one
# STACK_REDIS_COMMAND_TIMEOUT=250ms   # Docker Compose deployment override (validated in Phase 3A)
# REDIS_CONNECT_TIMEOUT=2s
# REDIS_POOL_ENABLED=false

# ---------- Application ----------
# Must be unique per running instance (used for per-instance statistics shards).
INSTANCE_ID=local-1
# SERVER_PORT=8080

# Regex of reverse-proxy IPs whose X-Forwarded-For header is trusted. Empty = trust none
# (X-Forwarded-For ignored). Set to the Nginx container address in the full Compose stack.
TRUSTED_PROXIES=

# ---------- Full stack (Docker Compose) ----------
# Host port for Nginx, the only entry point for API traffic in the full stack.
NGINX_HOST_PORT=8080
GRAFANA_ADMIN_PASSWORD=change-me

# ---------- Security ----------
# REQUIRED. HMAC-SHA256 key for JWT signing, base64, at least 32 random bytes:
#   openssl rand -base64 48
JWT_SECRET=change-me
